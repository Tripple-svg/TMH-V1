+    assert.equal(await count('playbook_purchases'), 1);
+    assert.equal((await rpc('admin_delete_lead', [review])).deleted, false);
+  });
+  console.log(`PostgreSQL checks: ${passed} passed, 0 failed`);
+} finally { await db.close(); }
