+  assert.ok(ui.render('PurchasesPanel', props).some((node) => node.type === 'button' && node.props.disabled && node.props.children.includes('Retrying…')));
+  finish({ status: 200, ok: true, purchase: { ...purchase, thankyou_sent: true } });
